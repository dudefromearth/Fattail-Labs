# FatTail Labs — full config surface. Copy to .env and fill in.
# Every variable here is REQUIRED unless noted; the server refuses to boot without them.

LABS_ENV=dev                          # dev | staging | production
LABS_PORT=4000

# MySQL
LABS_DB_HOST=127.0.0.1
LABS_DB_PORT=3306
LABS_DB_USER=labs
LABS_DB_PASSWORD=change-me
LABS_DB_NAME=labs
# Optional pool size (default 10). Phase E hardening.
#LABS_DB_POOL_SIZE=10

# Phase F — Bunny Stream for gated lesson video (optional until provider=bunny)
#LABS_BUNNY_LIBRARY_ID=
#LABS_BUNNY_TOKEN_KEY=
#LABS_BUNNY_EMBED_HOST=https://iframe.mediadelivery.net
#LABS_VIDEO_SIGNED_TTL_SECONDS=3600

# Phase G — HeyGen production from board (optional until live produce)
# HEYGEN_API_KEY=                    # also used by heygen CLI credentials
# LABS_HEYGEN_DRY_RUN=1              # force dry-run video_package when dry_run omitted
# LABS_CAST_DIR=                     # override docs/studio/cast (tests only)
# LABS_HEYGEN_MAX_BATCH=3            # max renders per produce (G2b)
# LABS_HEYGEN_DAILY_JOB_LIMIT=10     # live jobs/day (G3)
# LABS_HEYGEN_MONTHLY_JOB_LIMIT=100  # live jobs/month (G3)
# LABS_QUEBEC_AUTO=1                 # allow agent board:operate Quebec tick (G4)
# Automatic board poller (Quebec Poller Spec v1.0) — separate process:
#   LABS_QUEBEC_POLLER=1
#   LABS_QUEBEC_POLL_INTERVAL_SECONDS=60
#   LABS_QUEBEC_AUTO_PRODUCE=1
#   LABS_QUEBEC_AUTO_PRODUCE_MODE=fixtures   # fixtures | live | auto
#   LABS_QUEBEC_AUTO_HEYGEN=0
#   LABS_QUEBEC_MAX_ACTIONS=20
#   .venv/bin/python quebec_poller.py

# Dual-issuer WordPress SSO — secrets shared with WP fotw-sso plugin
# (same values as MarketSwarm-Canonical SSO_FOTW_SECRET / SSO_0DTE_SECRET).
# Source of truth: MarketSwarm-Canonical + fotw-sso. Guide:
# docs/WooCommerce-SSO-Integration-Guide.md
LABS_SSO_SECRET_FATTAIL=change-me     # JWT iss=fotw|fattail  (≥32 chars)
LABS_SSO_SECRET_0DTE=change-me        # JWT iss=0-dte

# Discord secrets — gitignored .env only (never commit real values).
# See docs/ops/WP-Discord-SSO-Claims-for-Labs.md · Foxtrot C0-5 · DL-241.
#
# 0-DTE Navigator guild (fotw-0dte-discord-bridge) — NOT FatTail AI Community:
# LABS_DISCORD_0DTE_GUILD_ID=
# LABS_DISCORD_0DTE_CLIENT_ID=
# LABS_DISCORD_0DTE_CLIENT_SECRET=
# LABS_DISCORD_0DTE_BOT_TOKEN=
# LABS_DISCORD_0DTE_ROLE_ID=
#
# FatTail AI Community bridge (Labs second window; C1c when enabled):
# LABS_DISCORD_BRIDGE=0
# LABS_DISCORD_CONNECT_URL=https://fattail.ai/my-account/
# LABS_DISCORD_GUILD_ID=
# LABS_DISCORD_BOT_TOKEN=
# LABS_DISCORD_APPLICATION_ID=
# LABS_DISCORD_CLIENT_ID=
# LABS_DISCORD_CLIENT_SECRET=
# LABS_DISCORD_PAID_ROLE_IDS=
# LABS_DISCORD_INTERNAL_KEY=            # ≥32 chars; launchd → internal API

# Session JWT
LABS_SESSION_SECRET=change-me
LABS_SESSION_TTL_SECONDS=604800       # 7 days
LABS_COOKIE_DOMAIN=                   # empty in dev; .fattail.ai in staging/production

# Labs administrators allowed to receive role_override via WordPress SSO is_admin.
# Required outside dev (fail loud). Comma-separated, case-insensitive.
# LABS_ADMIN_EMAILS=ernie@dudefromearth.com,coach@fattail.ai,conor@fattail.ai
# Optional: force WP reauth on SSO entry (default 1). Set 0 for seamless WP SSO.
# LABS_SSO_FORCE_REAUTH=1
# Optional extra CSRF origins (comma-separated). LABS_WEB_ORIGIN is always allowed.
# In production set LABS_WEB_ORIGIN=https://labs.fattail.ai so browser POSTs pass Origin checks.
# LABS_CSRF_ORIGINS=https://labs-stage.fattail.ai

# Optional: SSO buttons. Unset -> button not rendered.
# Same pattern as MSC LoginPage: WP /fotw-sso?redirect=<urlencoded Labs callback>
# Labs callback: https://labs.fattail.ai/api/auth/sso/wordpress:fattail  (plugin appends ?sso=)
# Entitlement mapping is DATA (plans + provider_plan_map), not env.
#LABS_SSO_LOGIN_URL_FATTAIL=https://fattail.ai/fotw-sso?redirect=https%3A%2F%2Flabs.fattail.ai%2Fapi%2Fauth%2Fsso%2Fwordpress%3Afattail
#LABS_SSO_LOGIN_URL_0DTE=https://0-dte.com/fotw-sso?redirect=https%3A%2F%2Flabs.fattail.ai%2Fapi%2Fauth%2Fsso%2Fwordpress%3A0-dte

# Optional: ActiveCampaign lead sync — push FREE waitlist signups (feature-gate
# emails) to AC as contacts tagged "Labs Lead". Absent config => disabled; the
# waitlist still works and captures/exports emails. Both URL and TOKEN required
# together. Purchasers are NOT tagged here (WooCommerce/WP plugin owns that).
# Shared FatTail / 0-DTE account. Spec: FatTail-Labs-ActiveCampaign-Lead-Sync-Spec-v1.0
# LABS_AC_API_URL=https://0dte.api-us1.com
# LABS_AC_API_TOKEN=change-me           # AC Settings -> Developer -> API Token
# LABS_AC_LEAD_TAG=Labs Lead            # tag applied to leads (default: Labs Lead)
# LABS_AC_TIMEOUT=15                    # per-request seconds (default 15)
# LABS_AC_REQUIRED=1                    # fail loud when a sync runs unconfigured

# Optional: admin notification email (FatTail Hostinger outbound)
# In-app + browser alerts work without this; email_status=skipped until set.
# Hostinger: https://www.hostinger.com/support/4305847-set-up-hostinger-email-on-your-applications-and-devices/
LABS_SMTP_HOST=smtp.hostinger.com
LABS_SMTP_PORT=465
LABS_SMTP_MODE=ssl
# Alternate if 465 fails: PORT=587 MODE=starttls
LABS_SMTP_FROM=labs@fattail.ai
LABS_SMTP_USER=labs@fattail.ai
LABS_SMTP_PASSWORD=change-me
# LABS_NOTIFY_EMAIL_REQUIRED=1
# Absolute links in mail (also used by billing + password-reset emails):
# LABS_WEB_ORIGIN=https://labs.fattail.ai
# LABS_PASSWORD_RESET_TTL_SECONDS=3600   # forgot-password link lifetime (300–86400)

# Journal session agent: local (default) | off
# LABS_JOURNAL_AGENT_MODE=local
# v0.7 guide charter (fail-loud when the agent runs)
LABS_COACH_POSTURE_DEFAULT=forward
LABS_COACH_MODEL_PROVIDER=xai
LABS_COACH_MODEL=grok-4
LABS_COACH_EFFORT_MAP=day_open:low,surface:low,extract:low,mechanical_turn:low

# Coach Conversation Lab (/admin/coach-lab) — off unless set to 1.
# When 1, XAI_API_KEY and XAI_API_BASE are required and abort boot if missing.
# LABS_COACH_LAB=1
# XAI_API_BASE=https://api.x.ai/v1

# ── Playbook scrapbook (Spec v1.1a · DL-255) — required for config + migrate.py ──
# Fail-loud: missing any of these aborts boot AND migrations (get_config is eager).
LABS_PLAYBOOK_ARCHIVE_MIME_ALLOWLIST=image/png,image/jpeg,image/jpg,image/webp,image/gif,application/pdf
LABS_PLAYBOOK_ARCHIVE_MAX_FILES=40
# 5 MiB per file
LABS_PLAYBOOK_ARCHIVE_MAX_BYTES_PER_FILE=5242880
# 50 MiB total archive per book
LABS_PLAYBOOK_ARCHIVE_MAX_BYTES_PER_BOOK=52428800
# 100 MiB export zip ceiling
LABS_PLAYBOOK_EXPORT_MAX_ZIP_BYTES=104857600
# Version retention (must be >= 1)
LABS_PLAYBOOK_VERSION_RETENTION_COUNT=50
# Optional override; empty → server/var/playbook_media
# LABS_PLAYBOOK_MEDIA_DIR=

# ── Phase 2 trade charts (Massive underlier OHLC · DL-256) ──
# Uses MASSIVE_API_KEY (or POLYGON_API_KEY) from Strategy Lab / market_data plane.
# Short-TTL in-process cache for chart bar windows (seconds, 5..3600).
# LABS_TRADE_CHART_CACHE_TTL_S=120

# ── Volume Profile dual store (Spec v0.4 · VP14 / VP17) ──
# Required when the VP plane is used (jobs / /api/me/market/volume-profile).
# LABS_MARKET_DATA_MOUNTS=raw-primary:/Volumes/sabrant2tb
# LABS_MARKET_DATA_ROOT=/Volumes/sabrant2tb/fattail-market-data
# LABS_VP_MAX_N_BINS=500000
