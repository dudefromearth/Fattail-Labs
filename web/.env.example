# FatTail Labs web — full config surface. Copy to .env.local for dev.
NEXT_PUBLIC_LABS_API_URL=http://localhost:4000
# Optional: server-side only base for SSR/RSC fetches when the public URL is
# not reachable from the Next process (e.g. docker/internal hostname).
# LABS_API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Course-hub intro video (YouTube id or full watch/youtu.be URL).
# Unset → uses the flagship course trailer, then a built-in fallback.
# NEXT_PUBLIC_LABS_INTRO_VIDEO_ID=izSfocWOB0E

# Public home countdown (pre-launch). ISO-8601 with timezone required.
# When unset or past, / redirects to the course hub (/hub).
# NEXT_PUBLIC_LABS_LAUNCH_AT=2026-08-01T09:00:00-04:00
# NEXT_PUBLIC_LABS_LAUNCH_LABEL=this weekend

# Heatmap LIM (Spec v0.4.3 Appendix A). Client-inlined via literal
# process.env.NEXT_PUBLIC_LABS_LIM_* (JR1 bundler seam). Copy names into
# .env / .env.local. Missing key → LIM unavailable, named error (C2).
# Spec §9 v1: floors 0/100, weights .50/.30/.20, bands 1.0/2.0, XPROX 0.5/1.5,
# trail 30/45, drift 1.0, both flags false.
# CENTRE_SCALE_PTS keys are exact ChainContext.symbol values (Heatmap: SPX).
# Both SPX and I:SPX may be listed; do not invent a prefix normaliser.
# NEXT_PUBLIC_LABS_LIM_CENTRE_SCALE_PTS
# NEXT_PUBLIC_LABS_LIM_BAND_CLOSE_PCT
# NEXT_PUBLIC_LABS_LIM_BAND_MEDIUM_PCT
# NEXT_PUBLIC_LABS_LIM_W_NET
# NEXT_PUBLIC_LABS_LIM_W_CONC
# NEXT_PUBLIC_LABS_LIM_W_MAG
# NEXT_PUBLIC_LABS_LIM_CONC_FLOOR
# NEXT_PUBLIC_LABS_LIM_CONC_SPAN
# NEXT_PUBLIC_LABS_LIM_MAG_FLOOR
# NEXT_PUBLIC_LABS_LIM_MAG_SPAN
# NEXT_PUBLIC_LABS_LIM_XPROX_FLOOR_PCT
# NEXT_PUBLIC_LABS_LIM_XPROX_CEIL_PCT
# NEXT_PUBLIC_LABS_LIM_TRAIL_INTERVAL_S
# NEXT_PUBLIC_LABS_LIM_TRAIL_WINDOW_MIN
# NEXT_PUBLIC_LABS_LIM_DRIFT_MIN_RATE
# NEXT_PUBLIC_LABS_LIM_SHOW_TRANSITION
# NEXT_PUBLIC_LABS_LIM_SHOW_ANNOTATIONS
